# 作品集默认使用离线演示模式，不联网、不产生模型调用费用。
DEMO_MODE=true

# 使用真实模型时改为 false，并填写下面三项。
# LLM_BASE_URL 填 OpenAI 兼容接口的 /v1 根地址，不要包含 /chat/completions。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=portfolio-demo
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=5

# 服务端安全上限，范围 1～20；HR 仍可在 UI 中为每个任务选择不超过该上限的数量。
LLM_MAX_CANDIDATES_PER_RUN=20

# 演示时由 FastAPI 同时提供静态页面；独立部署前端时设为 false。
SERVE_FRONTEND=true
# 多个地址用英文逗号分隔。
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# 普通 JSON/JSONL 运行数据目录，不使用数据库。
BACKEND_RUNTIME_DIR=src/backend/runtime
